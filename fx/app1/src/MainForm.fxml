<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MainFormController">
   <children>
      <Label layoutX="201.0" layoutY="14.0" text="My First Form" textFill="#e55920">
         <font>
            <Font name="System Bold Italic" size="31.0" />
         </font>
      </Label>
      <TextField fx:id="txtName" layoutX="107.0" layoutY="127.0" onKeyPressed="#printNameOnAction" promptText="name" />
      <Button layoutX="107.0" layoutY="223.0" mnemonicParsing="false" onAction="#printDataOnAction" style="-fx-background-color: blue;" text=" Click for Print" textFill="WHITE" textOverrun="CENTER_ELLIPSIS">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <TextField fx:id="txtAge" layoutX="107.0" layoutY="165.0" promptText="age" />
   </children>
</AnchorPane>
